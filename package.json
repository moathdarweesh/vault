{
  "name": "the-vault",
  "version": "1.0.0",
  "description": "THE VAULT — fitness tracking PWA, wrapped as an Android app with Capacitor + Health Connect.",
  "private": true,
  "scripts": {
    "dev": "node dev-server.js",
    "build:www": "node scripts/build-www.js",
    "sync": "npm run build:www && cap sync",
    "android": "npm run build:www && cap sync android && cap open android",
    "release": "node scripts/release.js",
    "release:check": "node scripts/release.js --check",
    "hooks": "git config core.hooksPath .githooks",
    "pdf": "node scripts/pdf/build-lld-pdf.js docs/LLD.md docs/LLD.pdf",
    "check": "node scripts/check-contracts.js",
    "sync:ios": "node scripts/sync-ios.js",
    "ios": "node scripts/sync-ios.js && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/local-notifications": "^8.2.1"
  }
}
