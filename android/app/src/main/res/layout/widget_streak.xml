<?xml version="1.0" encoding="utf-8"?>
<!--
  The streak. 2x2.

  NOT a lock-screen widget: Android removed those from phones in 12 and brought
  them back in 14 for tablets only. This is a home-screen identity tile, which
  is what it always really was.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textSize="13sp" android:textColor="#b0a69e" android:fontFamily="@font/vault_sans" android:text="" android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <LinearLayout
            android:id="@+id/widget_mark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layoutDirection="ltr">
            <ImageView android:layout_width="20dp" android:layout_height="30dp" android:src="@drawable/widget_mark_start" android:contentDescription="@null" />
            <ImageView android:layout_width="20dp" android:layout_height="30dp" android:layout_marginStart="8dp" android:src="@drawable/widget_mark_end" android:contentDescription="@null" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/widget_big" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="40sp" android:textColor="#ff6a00" android:fontFamily="@font/vault_mono_bold" android:includeFontPadding="false" android:maxLines="1" android:text="0" />
            <TextView android:id="@+id/widget_big_unit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:textSize="11sp" android:textColor="#b0a69e" android:fontFamily="@font/vault_sans" android:maxLines="1" android:ellipsize="end" android:text="" />
        </LinearLayout>

        <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:background="#1CFFE8D4" android:contentDescription="@null" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:orientation="horizontal" android:gravity="center" android:baselineAligned="true">
            <TextView android:id="@+id/widget_eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#b0a69e" android:fontFamily="@font/vault_sans" android:maxLines="1" android:text="" />
            <TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textSize="14sp" android:textColor="#fdfaf7" android:fontFamily="@font/vault_sans_bold" android:maxLines="1" android:ellipsize="end" android:text="" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
