<?xml version="1.0" encoding="utf-8"?>
<!--
  THE VAULT launcher icon, foreground layer.

  The identity is THE BARBELL (v403, owner decision): the five rectangles of
  ICONS.dumbbell in js/catalog.js, path for path in its 24-unit glyph space,
  in "the embers": outer plates ember #B84A00, inner plates the accent
  #FF6A00, the shaft bone #FDFAF7, on the black ic_launcher_background.
  Contract 72 holds this file, the themed and status-bar icons, icons/icon.svg
  and the splash to that one glyph. It used to draw THE CUT (a V with a slot
  and a hairline); never bring the V back.

  A VECTOR, not five PNG densities: minSdkVersion is 26, so mipmap-anydpi-v26
  always wins and the legacy density PNGs could never be loaded.

  DO NOT add a res/drawable-v24/ copy of this file. That qualifier outranks
  plain res/drawable on every device this app runs on, so a stale v24 copy
  silently shadows this one and ships the wrong glyph. It cost three releases.

  ADAPTIVE-ICON GEOMETRY: the canvas is 108x108dp but a launcher masks and
  parallaxes it, so only the inner 72dp (18..90) is guaranteed visible. The
  group scales the 24-unit glyph by 2.1 and moves it 28.8, which puts the
  glyph's centre (12,12) on (54,54). Ink lands at x 31.95..76.05 and
  y 41.4..66.6: 44.1dp across, about 61% of the safe zone, and the farthest
  corner (an outer plate's) sits 25.4dp from the centre, inside the 33dp
  keyline circle a round mask keeps.

  BAKED INTO THE APK: nothing here reaches a phone until a new APK (build 25)
  is built and installed.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2.1"
        android:scaleY="2.1"
        android:translateX="28.8"
        android:translateY="28.8">
        <!-- outer plates, 3x6 r1.2 -->
        <path
            android:fillColor="#FFB84A00"
            android:pathData="M2.7,9h0.6a1.2,1.2 0 0 1 1.2,1.2v3.6a1.2,1.2 0 0 1 -1.2,1.2h-0.6a1.2,1.2 0 0 1 -1.2,-1.2v-3.6a1.2,1.2 0 0 1 1.2,-1.2Z" />
        <path
            android:fillColor="#FFB84A00"
            android:pathData="M20.7,9h0.6a1.2,1.2 0 0 1 1.2,1.2v3.6a1.2,1.2 0 0 1 -1.2,1.2h-0.6a1.2,1.2 0 0 1 -1.2,-1.2v-3.6a1.2,1.2 0 0 1 1.2,-1.2Z" />
        <!-- inner plates, 4x12 r1.6 -->
        <path
            android:fillColor="#FFFF6A00"
            android:pathData="M7.1,6h0.8a1.6,1.6 0 0 1 1.6,1.6v8.8a1.6,1.6 0 0 1 -1.6,1.6h-0.8a1.6,1.6 0 0 1 -1.6,-1.6v-8.8a1.6,1.6 0 0 1 1.6,-1.6Z" />
        <path
            android:fillColor="#FFFF6A00"
            android:pathData="M16.1,6h0.8a1.6,1.6 0 0 1 1.6,1.6v8.8a1.6,1.6 0 0 1 -1.6,1.6h-0.8a1.6,1.6 0 0 1 -1.6,-1.6v-8.8a1.6,1.6 0 0 1 1.6,-1.6Z" />
        <!-- the shaft, 5x3.2, square -->
        <path
            android:fillColor="#FFFDFAF7"
            android:pathData="M9.5,10.4h5v3.2h-5Z" />
    </group>
</vector>
