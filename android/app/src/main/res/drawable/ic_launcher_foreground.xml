<?xml version="1.0" encoding="utf-8"?>
<!--
  THE VAULT launcher icon, foreground layer.

  The mark is the solid V letterform from the Claude Design brand kit
  ("Vault Brand Kit", section 01 APP ICON) — NOT the five bars. The bars are the
  in-app mark (ICONS.vault) and the status-bar icon (ic_stat_vault.xml); on the
  app icon they appear only as the pinstripe texture on the background layer.
  A previous pass put the bars on the tile, which was wrong.

  A VECTOR, not five PNG densities: minSdkVersion is 26, so mipmap-anydpi-v26
  always wins and the legacy density PNGs could never be loaded.

  ADAPTIVE-ICON GEOMETRY: the canvas is 108x108dp but a launcher masks and
  parallaxes it, so only the inner 72dp (18..90) is guaranteed visible. The
  group below scales the kit's 24-unit glyph by 2.895 and centres its INK (not
  its bounding box — the V is not vertically centred inside its own 24 box) on
  (54,54). Ink lands at x 32..76 and y 31..77: 44dp across, about 61% of the
  safe zone, which is the same glyph-to-tile ratio the kit draws.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2.895"
        android:scaleY="2.895"
        android:translateX="19.26"
        android:translateY="17.96">
        <path
            android:fillColor="#FF6A00"
            android:pathData="M4.4,4.5h3.4l4.2,11.4L16.2,4.5h3.4L13.7,20.4h-3.4Z" />
    </group>
</vector>
