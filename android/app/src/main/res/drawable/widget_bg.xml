<?xml version="1.0" encoding="utf-8"?>
<!-- The widget surface: the app's surface-1 (#0d0a07) with the machined edge the
     identity layer requires — a 1px warm border, never a shadow. The radius is
     16dp because that is what Android clips a widget to; the inner controls
     take 12dp, which is the app's own 2:1 corner law. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#0d0a07" />
    <corners android:radius="16dp" />
    <stroke android:width="1dp" android:color="#1F2B2620" />
</shape>
