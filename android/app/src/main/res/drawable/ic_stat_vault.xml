<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar (small) icon for the reminder notifications.

  Android renders a notification's small icon from its ALPHA CHANNEL ONLY and
  tints it with the notification colour, so this must be a white-on-transparent
  silhouette. Without this file the Capacitor plugin falls back to
  `android.R.drawable.ic_dialog_info` (LocalNotificationManager.getDefaultSmallIcon),
  which is a fully-opaque multi-colour system asset — flattened to alpha it is a
  featureless white blob, which is why the reminder never looked like ours.

  The glyph is the VAULT mark: five bars, no crossbar, flat caps and mitre joins,
  scaled from icons/icon.svg (512 -> 24) and enlarged to fill the 24dp box that
  the status bar expects.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M3,7.5V16.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="butt"
        android:strokeLineJoin="miter" />
    <path
        android:pathData="M7.5,3V21"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="butt"
        android:strokeLineJoin="miter" />
    <path
        android:pathData="M12,4.8V19.2"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="butt"
        android:strokeLineJoin="miter" />
    <path
        android:pathData="M16.5,3V21"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="butt"
        android:strokeLineJoin="miter" />
    <path
        android:pathData="M21,7.5V16.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="butt"
        android:strokeLineJoin="miter" />
</vector>
