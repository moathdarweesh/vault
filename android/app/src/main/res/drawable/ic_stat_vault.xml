<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar (small) icon for the reminder notifications.

  Android renders a notification's small icon from its ALPHA CHANNEL ONLY and
  tints it with the notification colour, so this must be a white-on-transparent
  silhouette. Without this file the Capacitor plugin falls back to
  `android.R.drawable.ic_dialog_info` (LocalNotificationManager.getDefaultSmallIcon),
  which is a fully-opaque multi-colour system asset. Flattened to alpha it is a
  featureless white blob, which is why the reminder never looked like ours.

  THE GLYPH IS THE SLOT MARK, not the letter. The Claude Design spec "Vault Logo
  CUT", section 02 SCALE, drops the letterform below 48px and lets the slot BE
  the mark: a tile with one slot cut out of it. This icon renders at roughly
  18px in a status bar, far under that threshold, so the letter would only turn
  to mud here. The spec names this exact surface as one the slot mark serves.

  It was the five bars until now, which was the pre-CUT identity.

  ALPHA-ONLY MEANS THE SLOT MUST BE A HOLE, not a painted bar: anything drawn
  gets tinted, so a "black" slot would come out the same colour as the tile.
  android:fillType="evenOdd" makes the inner subpath subtract from the outer.

  GEOMETRY: the spec's small tiles carry a corner radius of 25% and a slot 60%
  of the tile wide. The canvas is 24dp but a status bar wants a 1dp margin, so
  the tile is 22dp on (1,1)..(23,23) with r=5.5, and the slot is 13.2 across
  (60% of 22) and 2.5 tall, centred. 2.5 clears the spec's 2px floor.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M6.5,1h11a5.5,5.5 0 0 1 5.5,5.5v11a5.5,5.5 0 0 1 -5.5,5.5h-11a5.5,5.5 0 0 1 -5.5,-5.5v-11a5.5,5.5 0 0 1 5.5,-5.5zM5.4,10.75h13.2v2.5h-13.2z" />
</vector>
