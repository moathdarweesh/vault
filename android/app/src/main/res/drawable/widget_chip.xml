<?xml version="1.0" encoding="utf-8"?>
<!--
  The streak chip: accent-soft behind accent-line. Both are the accent at
  low alpha, so the chip reads as the brand tinting itself rather than as a
  second colour.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#21FF6A00" />
    <corners android:radius="8dp" />
    <stroke android:width="1dp" android:color="#4DFF6A00" />
</shape>
