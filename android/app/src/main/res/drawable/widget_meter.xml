<?xml version="1.0" encoding="utf-8"?>
<!-- The meter: an empty track in the app's surface-3 with the accent riding it. The
     accent is #ff6a00 in BOTH themes — that is the brand rule, and a widget
     that recoloured itself from the system palette would lose the one thing
     the app is recognised by. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#231b13" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="#ff6a00" />
                <corners android:radius="3dp" />
            </shape>
        </clip>
    </item>
</layer-list>
