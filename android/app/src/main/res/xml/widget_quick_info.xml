<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis is 0 ON PURPOSE, and that is the whole update model.

  Android's own period has a 30-minute FLOOR and wakes the device to honour it,
  so it would repaint on a schedule that has nothing to do with when the data
  changed. The app pushes instead: every save calls DB.widget.push(), which
  writes the snapshot and asks the providers to repaint. The widget is as fresh
  as the last time the app ran, and costs nothing while it is closed.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_quick"
    android:previewLayout="@layout/widget_quick"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen" />
