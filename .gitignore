node_modules/
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
.claude/

# Capacitor build output (regenerated by `npm run build:www`)
www/
# Android build artifacts (the android/ project itself is committed)
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/app/release/
*.apk

# Secrets and credentials — never commit these
.env
.env.*
*.jks
*.keystore
*.pfx
*.p12
# wrangler's local secrets file and its build/state cache (backend/worker) —
# `.dev.vars` is where GEMINI_KEY would sit for `wrangler dev`, and it must
# never reach the branch GitHub Pages serves.
.dev.vars
.dev.vars.*
.wrangler/

# Distribution APK hosted on GitHub Pages (Drive-free install)
!download/THE-VAULT.apk

# Generated knowledge-graph output (14MB: graph.json/html + wiki). Regenerate with /graphify.
graphify-out/
graphify-out.bak/

# Fingerprint-net capture records — local evidence, never shipped. GitHub Pages
# serves this branch directly, so a stray capture at the repo root would ship.
.fpnet/
.uxaudit/
